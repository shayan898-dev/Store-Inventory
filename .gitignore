# ============================================================
# Git Ignore Rules for Store-Inventory
# ============================================================

# Node dependencies & logs
node_modules/
server/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python virtual environment
.venv/
venv/
env/
ENV/

# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class

# PyInstaller build artifacts
build/
dist/
*.spec

# Local Environment & Config overrides
.env
.env.local

# Databases and temporary locks
inventory.db
test_store.db
*.db-shm
*.db-wal

# Mac/Windows system files
.DS_Store
Thumbs.db
